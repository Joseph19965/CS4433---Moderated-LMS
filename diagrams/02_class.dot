digraph{graph[label="Design-level Classes, Interfaces & Dependencies",labelloc=t,fontsize=19,rankdir=LR,pad=.2,nodesep=.32,ranksep=.85];node[shape=record,fontname=Helvetica,style=filled,fillcolor="#eef3fa",color="#6c89a7",fontsize=10];User[label="{Abstract User|#id_:int; #username_:string|+role():string (virtual)}"];roles[label="{Student / Lecturer / HoD / Administrator|+role():string}"];Factory[label="{UserFactory|+create(...):unique_ptr<User>}"];Service[label="{LmsService|-Database; -Policy; -Audit; -Repository|+submit(); +mark(); +moderate(); +classExtension(); +releaseCourse(); +lecturerSubmissions(); +hodSubmissions()}"];Strategy[label="{Interface LatePenaltyStrategy|+finalMark(raw,max,secondsLate):double}"];Penalty[label="{StandardLatePenalty|+finalMark(...):double}"];Observer[label="{Interface MarkObserver|+onMarkChange(...):void}"];Audit[label="{AuditService|+onMarkChange(...):void}"];Notice[label="{NotificationService|+onMarkChange(...):void}"];Repository[label="{SubmissionRepository|+get(); +insert(); +replace()}"];Database[label="{Database / Statement|+exec(); +bind(); +next()}"];roles->User[arrowhead=empty]; Factory->User[style=dashed];Service->Factory;Service->Penalty;Service->Audit;Service->Repository;Penalty->Strategy[arrowhead=empty];Audit->Observer[arrowhead=empty];Notice->Observer[arrowhead=empty];Repository->Database;Audit->Database;}
