digraph{graph[label="3NF Relational ERD (PK / FK and Cardinality)",labelloc=t,rankdir=TB,fontsize=19,nodesep=.3,ranksep=1.1,splines=polyline];node[shape=record,fontname=Helvetica,style=filled,fillcolor="#edf3f9",color="#427097",fontsize=10];department[label="{DEPARTMENT|PK department_id\lname UQ\l}"];users[label="{USERS|PK user_id\lusername UQ, password_hash\lrole, dept_id FK, active\l}"];course[label="{COURSE|PK course_id\lcode UQ, title, dept_id FK\l}"];cl[label="{COURSE_LECTURER|PK (course_id,lecturer_id)\lFK course_id, lecturer_id\l}"];en[label="{ENROLMENT|PK (course_id,student_id)\lFK course_id, student_id\l}"];assignment[label="{ASSIGNMENT|PK assignment_id\lFK course_id, created_by\ltitle, deadline, max_mark\l}"];extension[label="{EXTENSION|PK extension_id\lFK assignment_id, student_id, granted_by\lnew_deadline, reason\l}"];class[label="{CLASS_EXTENSION (CR1)|PK/FK assignment_id\lnew_deadline, reason\lgranted_by FK, updated_at\l}",fillcolor="#e7f5ee"];submission[label="{SUBMISSION|PK submission_id\lFK assignment_id, student_id\lcontent, submitted_at, status\l}"];mark[label="{MARK|PK mark_id\lFK/UQ submission_id\lraw_mark, final_mark, feedback\lmarked_by, moderated_by FK\l}"];audit[label="{AUDIT_EVENT|PK audit_id\lFK mark_id, actor_id\lchanged_at, old_value, new_value, reason\l}"];department->course[label="1:N"];department->users[label="1:N"];course->cl[label="1:N"];users->cl;course->en;users->en;course->assignment[label="1:N"];assignment->extension;assignment->class[label="1:0..1"];assignment->submission;users->submission;submission->mark[label="1:0..1"];mark->audit[label="1:N"]; }
