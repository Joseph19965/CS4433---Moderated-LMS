digraph{graph[label="Submission Lifecycle",labelloc=t,rankdir=LR,fontsize=19,nodesep=.35,ranksep=.55];node[shape=box,style="rounded,filled",fillcolor="#edf3f9",color="#427097"];Created;Submitted;Late;Marked;Moderated;Released[fillcolor="#e7f5ee"];Rejected[fillcolor="#faeded"];Created->Submitted[label="on time"];Created->Late[label="late"];Submitted->Submitted[label="resubmit before due"];Submitted->Marked;Late->Marked;Marked->Moderated[label="HoD approves"];Marked->Rejected[label="HoD rejects"];Rejected->Marked[label="re-mark"];Moderated->Released[label="HoD releases"];}
